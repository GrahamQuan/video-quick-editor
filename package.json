{
  "name": "video-quick-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-electron-signature.js && turbo dev --filter=@video-quick-editor/desktop",
    "build": "turbo build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --deny-warnings scripts && turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=@video-quick-editor/desktop",
    "package": "turbo package --filter=@video-quick-editor/desktop",
    "package:dir": "turbo package:dir --filter=@video-quick-editor/desktop"
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
